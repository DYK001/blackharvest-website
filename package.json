{
  "name": "blackharvest-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run media:check && npm run i18n:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "status:check": "tsx scripts/status-publisher/cli.mts check",
    "status:publish": "tsx scripts/status-publisher/cli.mts publish",
    "status:restore": "tsx scripts/status-publisher/cli.mts restore",
    "test:status": "tsx --test scripts/status-publisher/*.test.mts",
    "media:check": "tsx scripts/media/check.mts",
    "test:media": "tsx --test scripts/media/*.test.mts",
    "i18n:check": "tsx scripts/i18n/check.mts"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "zod": "^4.5.4"
  }
}
